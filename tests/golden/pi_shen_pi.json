    {
      "_ming": "setTitle：fire-and-forget，不许回",
      "_zuo_yong": null,
      "wire": {
        "type": "extension_ui_request",
        "id": "uuid-8",
        "method": "setTitle",
        "title": "pi - my project"
      },
      "hui_ying": null
    },
    {
      "_ming": "set_editor_text：fire-and-forget，不许回",
      "_zuo_yong": null,
      "wire": {
        "type": "extension_ui_request",
        "id": "uuid-9",
        "method": "set_editor_text",
        "text": "prefilled text for the user"
      },
      "hui_ying": null
    },
    {
      "_ming": "对话框请求但没有 id：**一条响应都不能回**（pi 那边用 id 配对，无 id 的请求配不上，回了也是写进 stdin 的垃圾）",
      "_zuo_yong": null,
      "wire": {
        "type": "extension_ui_request",
        "method": "confirm",
        "title": "Clear session?",
