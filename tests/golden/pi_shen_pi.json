{
  "_shuo_ming": "L-B golden：审批与提问的 extension_ui_request。**wire 逐字抄自 pi 1.0.2 自带的 docs/rpc-extension-ui.md 的示例 JSON**（该文档就是本机安装包里的文件，与 dist/modes/rpc/rpc-mode.js 的 emit 点逐条对得上）；响应形状以同文档的 Responses to Pi 段为准。",
  "_lai_yuan": "pi 1.0.2 docs/rpc-extension-ui.md（对话框方法示例 + Responses 段）；dist/modes/rpc/rpc-mode.js 的 createExtensionUIContext.* 与 `parsed.type === \"extension_ui_response\"` 分支；cc-connect agent/pi/session.go 的 forwardConfirm / forwardInput / forwardSelect 与 RespondPermission",
  "_hui_ying": "extension_ui_response 的形状。**不是 JSON-RPC 的 result**——pi 认的是 confirmed / value / cancelled 三个平铺字段。",
  "_zhan_bu_diao": "**必须不回的五种 fire-and-forget**（notify / setStatus / setWidget / setTitle / set_editor_text）：它们在 pi 那边不往 pendingExtensionRequests 里塞 Promise，回响应是无操作（dist/modes/rpc/rpc-mode.js 里这五个方法只调 output(...)）。回错了不会报错，但会让「回响应」这条路径的行为与文档不一致——所以判据是「一条都不许写出去」。",
  "cases": [
    {
      "_ming": "confirm 审批：allow 回 confirmed=true，deny 回 confirmed=false（不是 cancelled）",
      "_zuo_yong": "permission",
      "_dao_yan": "用户对问题的回答：\n- 允许",
      "wire": {
        "type": "extension_ui_request",
        "id": "uuid-2",
        "method": "confirm",
        "title": "Clear session?",
        "message": "All messages will be lost.",
        "timeout": 5000
      },
      "hui_ying": {
        "confirmed": true
      },
      "hui_ying_bie": {
        "confirmed": false
      }
    },
    {
      "_ming": "confirm 带 timeout：pi 侧超时会自动按默认值 resolve，**不需要我们管超时**，但确认键仍必须是 confirmed（docs 的 Confirmation response 段）",
      "_zuo_yong": "permission",
      "_dao_yan": "用户对问题的回答：\n- 允许",
      "wire": {
        "type": "extension_ui_request",
        "id": "uuid-2b",
        "method": "confirm",
        "title": "Allow dangerous command?",
        "message": "rm -rf ./build",
        "timeout": 10000
      },
      "hui_ying": {
        "confirmed": true
      },
      "hui_ying_bie": {
        "confirmed": false
      }
    },
    {
      "_ming": "select 提问：值必须是 options 里的**原样字符串**（docs：value (the selected option string)）",
      "_zuo_yong": "question",
      "_dao_yan": "用户对问题的回答：\n- Allow",
      "wire": {
        "type": "extension_ui_request",
        "id": "uuid-1",
        "method": "select",
        "title": "Allow dangerous command?",
        "options": [
          "Allow",
          "Block"
        ],
        "timeout": 10000
      },
      "hui_ying": {
        "value": "Allow"
      },
      "hui_ying_bie": {
        "cancelled": true
      }
    },
    {
      "_ming": "select 带对象选项（label + description）：**必须原样回 label 字符串**，不能让 options 变成对象数组",
      "_zuo_yong": "question",
      "_dao_yan": "用户对问题的回答：\n- dev",
      "wire": {
        "type": "extension_ui_request",
        "id": "uuid-1b",
        "method": "select",
        "title": "用哪个分支",
        "options": [
          {
            "label": "main",
            "description": "主干"
          },
          {
            "label": "dev",
            "description": "开发"
          }
        ]
      },
      "hui_ying": {
        "value": "dev"
      },
      "hui_ying_bie": {
        "cancelled": true
      }
    },
    {
      "_ming": "input 提问：回 value（裸字符串，不带 arbiter 的前缀）",
      "_zuo_yong": "question",
      "_dao_yan": "用户对问题的回答：\n- hello.py",
      "wire": {
        "type": "extension_ui_request",
        "id": "uuid-3",
        "method": "input",
        "title": "Enter a value",
        "placeholder": "type something..."
      },
      "hui_ying": {
        "value": "hello.py"
      },
      "hui_ying_bie": {
        "cancelled": true
      }
    },
    {
      "_ming": "editor：与 input 同一条回路，回 value",
      "_zuo_yong": "question",
      "_dao_yan": "用户对问题的回答：\n- 改过的内容",
      "wire": {
        "type": "extension_ui_request",
        "id": "uuid-4",
        "method": "editor",
        "title": "Edit some text",
        "prefill": "Line 1\nLine 2\nLine 3"
      },
      "hui_ying": {
        "value": "改过的内容"
      },
      "hui_ying_bie": {
        "cancelled": true
      }
    },
    {
      "_ming": "notify：fire-and-forget，**一条响应都不许写**（回它没有语义）",
      "_zuo_yong": null,
      "wire": {
        "type": "extension_ui_request",
