# Dependencies
node_modules/
.pnpm-store/

# Build output（根目录 dist/ 与 build/ 为打包产物，按要求入库）
.next/
out/
coverage/

# Environment and secrets
.env
.env.*
!.env.example

# Logs
*.log
logs/
.logs/
backend/.lifeos-state/

# Local runtime / TypeScript incremental state
.run_pids.txt
*.tsbuildinfo

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Python cache
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# 打包产物中的编译扩展（.pyd 是 Windows 的动态库，软件运行必需，须入库）
!dist/**/*.pyd
!build/**/*.pyd

# Temporary files
*.tmp
*.temp
~$*.pptx
.lifeos/

# CodeGraph index
.codegraph/

# OMC / agent session runtime state
.omc/
