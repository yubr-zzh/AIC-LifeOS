# Dependencies
node_modules/
.pnpm-store/

# Build output（根目录 dist/ 与 build/ 为打包产物，按要求入库）
.next/
out/
coverage/

# Environment and secrets
.env
.env.*
!.env.example

# Logs
*.log
logs/
.logs/
backend/.lifeos-state/

# Local runtime / TypeScript incremental state
.run_pids.txt
*.tsbuildinfo

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Python cache
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# 打包产物中的编译扩展（.pyd 是 Windows 的动态库，软件运行必需，须入库）
!dist/**/*.pyd
!build/**/*.pyd

# 捆绑的 claude CLI 运行时（约 230 MB）。GitHub 单文件硬上限 100 MB，
# 推不上去；安装包也不含它，运行时由 `resolve_claude_runtime()` 沿 PATH 探测。
dist/LifeOS/resources/node/

# Temporary files
*.tmp
*.temp
~$*.pptx
.lifeos/

# 本机运行时数据。LIFEOS_HOME 默认落在 ./lifeos/，与 Python 包目录同名，
# 于是个人笔记、记忆和会话历史散落在包目录里。**这些绝不入库**——
# 仓库是公开的，推上去就撤不回来。
lifeos/lifeos.db
lifeos/memory.json
lifeos/events.json
lifeos/agent_evidence.json
lifeos/models.json
lifeos/skills.json
tests/lifeOS/
# WebView2 用户数据目录：桌面壳按 LIFEOS_HOME/webview 创建，默认落在包目录内
lifeos/webview/

# 与项目无关的个人文件（课程作业与报告脚本）
render/
thevenin_step*.png
modify_report.py

# CodeGraph index
.codegraph/

# OMC / agent session runtime state
.omc/
